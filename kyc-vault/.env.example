# Example environment variables for KYC Vault

# Node Environment
NODE_ENV=development
LOG_LEVEL=debug

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=kyc-admin
DB_PASSWORD=change-me-in-production
DB_NAME=kyc-vault

# Service URLs
VERAMO_AGENT_URL=http://localhost:3001
ISSUER_SERVICE_URL=http://localhost:3002
VERIFIER_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3004
REVOCATION_SERVICE_URL=http://localhost:3005

# Ports
PORT=3001
ISSUER_PORT=3002
VERIFIER_PORT=3003
NOTIFICATION_PORT=3004
REVOCATION_PORT=3005

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT/Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=24h

# Did Methods
SUPPORTED_DID_METHODS=did:ion,did:key,did:ethr,did:cheqd

# Ledger Configuration
ION_NETWORK=testnet
CHEQD_NETWORK=testnet
ETHEREUM_RPC_URL=https://goerli.infura.io/v3/YOUR_PROJECT_ID

# Firebase (optional, for push notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-email@your-project.iam.gserviceaccount.com

# AWS (for production HSM/KMS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
KMS_KEY_ID=your-kms-key-id

# Vault (for secrets management)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_URL=http://localhost:3000
LOKI_URL=http://localhost:3100

# AML/Compliance
COMPLY_ADVANTAGE_API_KEY=your-api-key
SANCTIONLIST_PROVIDER=un

# CORS
CORS_ORIGIN=http://localhost:8081,http://localhost:3000

# Feature Flags
ENABLE_SELECTIVE_DISCLOSURE=true
ENABLE_ZK_PROOFS=false
ENABLE_REVOCATION_CHECK=true
